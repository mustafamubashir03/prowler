# Copy this file to `.env` and replace the placeholders with your real values.

# --- Database (PostgreSQL 15+) ---
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="<32+ random bytes, base64url>"
BETTER_AUTH_URL="http://localhost:3000"

# --- GitHub App ---
# Settings -> Developer settings -> Your GitHub Apps -> <app>
# Numeric App ID (not the client ID).
GITHUB_APP_ID=""

# The app's client ID and client secret. Used by the Better Auth GitHub
# social provider so sign-in and the install flow share one identity.
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# The app's URL slug, e.g. "prowler" for github.com/apps/prowler.
GITHUB_APP_SLUG=""

# The app's private key, pasted inline. Keep the surrounding quotes and the
# literal \n escapes, or paste the key with real newlines - both are accepted.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Webhook signing secret. Required by /api/github/webhooks/github.
GITHUB_WEBHOOK_SECRET=""

# --- App ---
# Base URL used for post-install redirects. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Inngest ---
# Locally set INNGEST_DEV=1 and run `npx inngest-cli@latest dev` instead of
# using keys. In production these two are required.
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Indexing ---
# Jina embeds each chunk. jina-embeddings-v3 is 1024 dimensions.
JINA_API_KEY=""

# The Pinecone index must already exist at 1024 dimensions with the cosine
# metric. The dimension has to match the embeddings exactly or upsert fails.
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""

# --- Review agent ---
# Sent as the Anthropic auth token, since the Claude Agent SDK is pointed at
# OpenRouter's Anthropic-compatible endpoint.
OPENROUTER_API_KEY=""

# Optional. Defaults to nvidia/nemotron-3.5-lightning:free, which was the only
# free model tested that reliably returned the full review format.
AGENT_MODEL=""